---
// EventList — fetches upcoming events from the venyou public API and renders them client-side.
// Displays a loading skeleton, then replaces it with live event data.
---

<section id="event-list" class="space-y-3">
  {Array.from({ length: 3 }).map(() => (
    <div class="event-skeleton border border-neutral-900 rounded-lg p-5 animate-pulse">
      <div class="h-3 w-24 bg-neutral-800 rounded" />
      <div class="mt-2 h-6 w-48 bg-neutral-800 rounded" />
      <div class="mt-2 h-3 w-32 bg-neutral-800 rounded" />
    </div>
  ))}
</section>

<script>
  async function loadEvents() {
    const container = document.getElementById("event-list");
    if (!container) return;

    try {
      const res = await fetch("/api/events");
      if (!res.ok) throw new Error(res.statusText);
      const { events } = await res.json();

      if (!events || events.length === 0) {
        container.innerHTML = `
          <p class="text-neutral-500 text-sm">No upcoming events — check back soon.</p>
        `;
        return;
      }

      container.innerHTML = events
        .map(
          (e: any) => {
            const date = new Date(e.eventDate + "T00:00:00");
            const formatted = date.toLocaleDateString("en-US", {
              weekday: "short",
              month: "short",
              day: "numeric",
              year: "numeric",
            });
            let time = "";
            if (e.startTime && e.startTime.includes(":")) {
              const [h, m] = e.startTime.split(":");
              const hour = parseInt(h, 10);
              const ampm = hour >= 12 ? "PM" : "AM";
              const h12 = hour % 12 || 12;
              time = `${h12}:${m} ${ampm}`;
            }
            let venue = "";
            if (typeof e.venue === "object" && e.venue?.name) {
              venue = `${e.venue.name}${e.venue.city ? ` · ${e.venue.city}` : ""}${e.venue.state ? `, ${e.venue.state}` : ""}`;
            } else if (typeof e.venue === "string" && e.venue) {
              venue = e.venue;
              if (e.city) venue += `, ${e.city}`;
              if (e.state) venue += ` ${e.state}`;
            }
            const ticketLink = e.ticketUrl
              ? `<a href="${e.ticketUrl}" target="_blank" rel="noopener" class="mt-4 inline-block px-5 py-2 rounded-full border border-neutral-600 text-sm text-neutral-100 hover:border-neutral-400 hover:text-white transition-colors">Get tickets</a>`
              : "";

            if (e.flyerUrl) {
              return `
                <li class="border border-neutral-900 rounded-xl overflow-hidden hover:border-neutral-700 transition-colors list-none">
                  <img src="${e.flyerUrl}" alt="Flyer for ${e.title}" class="w-full object-cover" style="max-height:480px" loading="lazy" />
                  <div class="p-5">
                    <div class="text-xs uppercase tracking-wider text-neutral-500">${formatted}${time ? ` · ${time}` : ""}</div>
                    <div class="mt-1 font-[Space_Grotesk,system-ui,sans-serif] text-2xl font-bold">${e.title}</div>
                    ${venue ? `<div class="mt-1 text-sm text-neutral-400">${venue}</div>` : ""}
                    ${e.description ? `<div class="mt-2 text-sm text-neutral-400">${e.description}</div>` : ""}
                    ${ticketLink}
                  </div>
                </li>
              `;
            }

            return `
              <li class="border border-neutral-900 rounded-xl p-5 hover:border-neutral-700 transition-colors list-none">
                <div class="text-xs uppercase tracking-wider text-neutral-500">${formatted}${time ? ` · ${time}` : ""}</div>
                <div class="mt-1 font-[Space_Grotesk,system-ui,sans-serif] text-xl font-bold">${e.title}</div>
                ${venue ? `<div class="mt-1 text-sm text-neutral-400">${venue}</div>` : ""}
                ${e.description ? `<div class="mt-2 text-sm text-neutral-400">${e.description}</div>` : ""}
                ${ticketLink}
              </li>
            `;
          }
        )
        .join("");
    } catch {
      container.innerHTML = `
        <p class="text-neutral-500 text-sm">No upcoming events — check back soon.</p>
      `;
    }
  }

  loadEvents();
</script>
