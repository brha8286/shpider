---
// PastEventList — fetches public past events from the events API and renders them.
// The whole section stays hidden until at least one past event loads, so an empty
// history never shows a bare "Past" heading.
---

<section id="past-events" class="pt-14 sm:pt-20" hidden>
  <h2 class="font-[Space_Grotesk,system-ui,sans-serif] text-3xl sm:text-4xl font-bold">
    Past
  </h2>
  <div id="past-event-list" class="mt-8 space-y-3"></div>
</section>

<script>
  async function loadPastEvents() {
    const section = document.getElementById("past-events");
    const container = document.getElementById("past-event-list");
    if (!section || !container) return;

    try {
      const res = await fetch("/api/events?past=1");
      if (!res.ok) throw new Error(res.statusText);
      const { events } = await res.json();

      if (!events || events.length === 0) return;

      container.innerHTML = events
        .map((e: any) => {
          const date = new Date(e.eventDate + "T00:00:00");
          const formatted = date.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          });
          let venue = "";
          if (typeof e.venue === "object" && e.venue?.name) {
            venue = `${e.venue.name}${e.venue.city ? ` · ${e.venue.city}` : ""}${e.venue.state ? `, ${e.venue.state}` : ""}`;
          } else if (typeof e.venue === "string" && e.venue) {
            venue = e.venue;
            if (e.city) venue += `, ${e.city}`;
            if (e.state) venue += ` ${e.state}`;
          }

          if (e.flyerUrl) {
            return `
              <li class="border border-neutral-900 rounded-xl p-5 hover:border-neutral-700 transition-colors list-none flex gap-5 items-start opacity-80">
                <div class="min-w-0 flex-1 flex flex-col" style="min-height:200px">
                  <div class="text-xs uppercase tracking-wider text-neutral-500">${formatted}</div>
                  <div class="flex-1 flex flex-col justify-center">
                    <div class="font-[Space_Grotesk,system-ui,sans-serif] text-xl font-bold">${e.title}</div>
                    ${venue ? `<div class="mt-2 text-sm text-neutral-400">${venue}</div>` : ""}
                  </div>
                  ${e.description ? `<div class="text-sm text-neutral-400">${e.description}</div>` : ""}
                </div>
                <img src="${e.flyerUrl}" alt="Flyer for ${e.title}" loading="lazy" style="height:200px;width:auto;max-width:40%;object-fit:contain;flex-shrink:0;border-radius:0.5rem" />
              </li>
            `;
          }

          return `
            <li class="border border-neutral-900 rounded-xl p-5 hover:border-neutral-700 transition-colors list-none opacity-80">
              <div class="text-xs uppercase tracking-wider text-neutral-500">${formatted}</div>
              <div class="mt-1 font-[Space_Grotesk,system-ui,sans-serif] text-xl font-bold">${e.title}</div>
              ${venue ? `<div class="mt-1 text-sm text-neutral-400">${venue}</div>` : ""}
              ${e.description ? `<div class="mt-2 text-sm text-neutral-400">${e.description}</div>` : ""}
            </li>
          `;
        })
        .join("");

      section.hidden = false;
    } catch {
      // leave the section hidden on error
    }
  }

  loadPastEvents();
</script>
