---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Motif Movement",
  description = "Motif Movement — Lubbock sound system collective",
} = Astro.props;

const tabs = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/gallery", label: "Gallery" },
  { href: "/events", label: "Events" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen text-neutral-100 font-[Inter,system-ui,sans-serif] antialiased" style="background-color:#0a0a0a; background-image: url('/customer-assets/double%20sprout%20and%20system%20png.png'); background-size: cover; background-position: center; background-attachment: fixed; background-repeat: no-repeat;">
    <div class="fixed inset-0 bg-neutral-950/70 pointer-events-none" style="z-index:0;"></div>
    <div class="relative" style="z-index:1;">
    <header class="pt-10 sm:pt-14 pb-4 px-4">
      <a href="/" class="block text-center group">
        <img
          src="/customer-assets/motif-logo.png"
          alt="Motif Movement"
          class="mx-auto h-16 sm:h-20 md:h-24 w-auto"
        />
        <p class="mt-3 text-[10px] sm:text-xs uppercase tracking-[0.35em] text-neutral-500">
          Lubbock · Texas
        </p>
      </a>
      <nav class="mt-8 sm:mt-10 -mx-4 overflow-x-auto scrollbar-hide">
        <ul class="flex justify-start sm:justify-center gap-1 text-sm sm:text-base whitespace-nowrap px-4 min-w-max mx-auto">
          {
            tabs.map((tab) => {
              const active = isActive(tab.href);
              return (
                <li>
                  <a
                    href={tab.href}
                    class:list={[
                      "block px-4 py-2 rounded-full transition-colors duration-200",
                      active
                        ? "bg-neutral-100 text-neutral-950 font-semibold"
                        : "text-neutral-400 hover:text-neutral-100",
                    ]}
                  >
                    {tab.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>

    <main class="px-4 pb-20 max-w-3xl mx-auto">
      <slot />
    </main>

    <footer class="border-t border-neutral-900 mt-10">
      <div class="max-w-3xl mx-auto px-4 py-8 text-center text-xs text-neutral-600">
        © {new Date().getFullYear()} Motif Movement · Lubbock, TX
      </div>
    </footer>

    <style is:global>
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
    </div>
  </body>
</html>
