---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin — Motif Movement">
  <section class="pt-10 sm:pt-14 max-w-2xl">
    <!-- Login gate -->
    <div id="login-gate">
      <h2 class="font-[Space_Grotesk,system-ui,sans-serif] text-2xl font-bold mb-4">Admin</h2>
      <div class="bg-neutral-900 rounded-lg border border-neutral-800 p-6">
        <label class="block text-sm text-neutral-400 mb-2">Site password</label>
        <input
          type="password"
          id="password-input"
          class="w-full px-4 py-3 bg-neutral-950 border border-neutral-700 rounded-md text-neutral-100 focus:outline-none focus:border-neutral-500"
          placeholder="Enter password"
        />
        <button
          id="login-btn"
          class="mt-3 w-full px-6 py-3 rounded-full bg-neutral-100 text-neutral-950 font-semibold hover:bg-white transition-colors"
        >
          Log in
        </button>
        <p id="login-error" class="mt-2 text-sm text-red-400 hidden">Wrong password</p>
      </div>
    </div>

    <!-- Admin panel (hidden until authenticated) -->
    <div id="admin-panel" class="hidden">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-[Space_Grotesk,system-ui,sans-serif] text-2xl font-bold">Admin</h2>
        <button id="logout-btn" class="text-sm text-neutral-500 hover:text-neutral-300 transition-colors">Log out</button>
      </div>

      <!-- Tab switcher -->
      <div class="flex gap-1 mb-6">
        <button class="admin-tab px-4 py-2 rounded-full text-sm font-medium transition-colors bg-neutral-100 text-neutral-950" data-tab="events">Events</button>
        <button class="admin-tab px-4 py-2 rounded-full text-sm font-medium transition-colors text-neutral-400 hover:text-neutral-100" data-tab="gallery">Gallery</button>
      </div>

      <!-- EVENTS TAB -->
      <div id="tab-events">
        <!-- Add event form -->
        <div class="bg-neutral-900 rounded-lg border border-neutral-800 p-4 mb-6">
          <h3 class="text-sm font-semibold text-neutral-200 mb-3">Add event</h3>
          <div class="space-y-3">
            <input type="text" id="evt-title" placeholder="Event title *" class="admin-input" />
            <div class="grid grid-cols-2 gap-3">
              <input type="date" id="evt-date" class="admin-input" />
              <input type="time" id="evt-time" class="admin-input" placeholder="Start time" />
            </div>
            <input type="text" id="evt-venue" placeholder="Venue name" class="admin-input" />
            <div class="grid grid-cols-2 gap-3">
              <input type="text" id="evt-city" placeholder="City" class="admin-input" />
              <input type="text" id="evt-state" placeholder="State" class="admin-input" />
            </div>
            <textarea id="evt-desc" rows={2} placeholder="Description" class="admin-input"></textarea>
            <input type="url" id="evt-ticket" placeholder="Ticket link (optional)" class="admin-input" />
            <input type="url" id="evt-flyer" placeholder="Flyer image URL (optional)" class="admin-input" />
            <button id="evt-add-btn" class="w-full px-4 py-2.5 rounded-full bg-neutral-100 text-neutral-950 font-semibold text-sm hover:bg-white transition-colors">
              Add event
            </button>
          </div>
        </div>

        <!-- Event list -->
        <div id="events-list" class="space-y-3"></div>
      </div>

      <!-- GALLERY TAB -->
      <div id="tab-gallery" class="hidden">
        <!-- Add image form -->
        <div class="bg-neutral-900 rounded-lg border border-neutral-800 p-4 mb-6">
          <h3 class="text-sm font-semibold text-neutral-200 mb-3">Add image</h3>
          <div class="space-y-3">
            <input type="url" id="gal-url" placeholder="Image URL *" class="admin-input" />
            <input type="text" id="gal-caption" placeholder="Caption (optional)" class="admin-input" />
            <div id="gal-preview" class="hidden">
              <img id="gal-preview-img" class="max-h-32 rounded-md border border-neutral-700" />
            </div>
            <button id="gal-add-btn" class="w-full px-4 py-2.5 rounded-full bg-neutral-100 text-neutral-950 font-semibold text-sm hover:bg-white transition-colors">
              Add to gallery
            </button>
          </div>
        </div>

        <!-- Gallery grid -->
        <div id="gallery-list" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
      </div>

      <!-- Status message -->
      <div id="admin-status" class="fixed bottom-4 left-1/2 -translate-x-1/2 px-4 py-2 rounded-full text-sm font-medium bg-neutral-100 text-neutral-950 hidden transition-opacity"></div>
    </div>
  </section>
</Layout>

<style>
  .admin-input {
    width: 100%;
    padding: 0.625rem 1rem;
    background: #0a0a0a;
    border: 1px solid #404040;
    border-radius: 0.375rem;
    color: #f5f5f5;
    font-size: 0.875rem;
  }
  .admin-input:focus {
    outline: none;
    border-color: #737373;
  }
</style>

<script>
  // --- Auth ---
  const loginGate = document.getElementById("login-gate")!;
  const adminPanel = document.getElementById("admin-panel")!;
  const passwordInput = document.getElementById("password-input") as HTMLInputElement;
  const loginBtn = document.getElementById("login-btn")!;
  const loginError = document.getElementById("login-error")!;
  const logoutBtn = document.getElementById("logout-btn")!;

  async function checkAuth() {
    const res = await fetch("/api/auth");
    const { authenticated } = await res.json();
    if (authenticated) {
      loginGate.classList.add("hidden");
      adminPanel.classList.remove("hidden");
      loadEvents();
      loadGallery();
    }
  }

  loginBtn.addEventListener("click", async () => {
    const res = await fetch("/api/auth", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ password: passwordInput.value }),
    });
    if (res.ok) {
      loginError.classList.add("hidden");
      loginGate.classList.add("hidden");
      adminPanel.classList.remove("hidden");
      loadEvents();
      loadGallery();
    } else {
      loginError.classList.remove("hidden");
    }
  });

  passwordInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") loginBtn.click();
  });

  logoutBtn.addEventListener("click", () => {
    document.cookie = "motif_admin=; Path=/; Max-Age=0";
    adminPanel.classList.add("hidden");
    loginGate.classList.remove("hidden");
    passwordInput.value = "";
  });

  // --- Tabs ---
  const tabs = document.querySelectorAll(".admin-tab");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = (tab as HTMLElement).dataset.tab!;
      tabs.forEach((t) => {
        const el = t as HTMLElement;
        if (el.dataset.tab === target) {
          el.classList.add("bg-neutral-100", "text-neutral-950");
          el.classList.remove("text-neutral-400");
        } else {
          el.classList.remove("bg-neutral-100", "text-neutral-950");
          el.classList.add("text-neutral-400");
        }
      });
      document.getElementById("tab-events")!.classList.toggle("hidden", target !== "events");
      document.getElementById("tab-gallery")!.classList.toggle("hidden", target !== "gallery");
    });
  });

  // --- Status toast ---
  function showStatus(msg: string) {
    const el = document.getElementById("admin-status")!;
    el.textContent = msg;
    el.classList.remove("hidden");
    setTimeout(() => el.classList.add("hidden"), 2500);
  }

  // --- Events ---
  const eventsListEl = document.getElementById("events-list")!;

  async function loadEvents() {
    const res = await fetch("/api/events?all=1");
    const { events } = await res.json();
    renderEvents(events);
  }

  function renderEvents(events: any[]) {
    if (events.length === 0) {
      eventsListEl.innerHTML = `<p class="text-neutral-500 text-sm">No events yet.</p>`;
      return;
    }
    eventsListEl.innerHTML = events
      .map((e: any) => {
        const date = new Date(e.eventDate).toLocaleDateString("en-US", {
          weekday: "short", month: "short", day: "numeric", year: "numeric",
        });
        return `
          <div class="border border-neutral-800 rounded-lg p-4 ${!e.isPublic ? 'opacity-50' : ''}">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <div class="text-xs uppercase tracking-wider text-neutral-500">${date}</div>
                <div class="mt-1 font-[Space_Grotesk,system-ui,sans-serif] text-lg font-bold truncate">${e.title}</div>
                ${e.venue ? `<div class="text-sm text-neutral-400">${e.venue}${e.city ? `, ${e.city}` : ''}</div>` : ''}
              </div>
              <div class="flex gap-1 shrink-0">
                <button onclick="toggleEventPublic('${e.id}', ${!e.isPublic})" class="px-2 py-1 text-xs rounded-full ${e.isPublic ? 'bg-green-500/20 text-green-400' : 'bg-neutral-800 text-neutral-500'}">
                  ${e.isPublic ? 'Public' : 'Hidden'}
                </button>
                <button onclick="deleteEvent('${e.id}')" class="px-2 py-1 text-xs rounded-full bg-red-500/10 text-red-400 hover:bg-red-500/20">
                  Delete
                </button>
              </div>
            </div>
          </div>
        `;
      })
      .join("");
  }

  document.getElementById("evt-add-btn")!.addEventListener("click", async () => {
    const title = (document.getElementById("evt-title") as HTMLInputElement).value.trim();
    const eventDate = (document.getElementById("evt-date") as HTMLInputElement).value;
    if (!title || !eventDate) return showStatus("Title and date are required");

    const body: any = {
      title,
      eventDate,
      startTime: (document.getElementById("evt-time") as HTMLInputElement).value || "",
      venue: (document.getElementById("evt-venue") as HTMLInputElement).value.trim(),
      city: (document.getElementById("evt-city") as HTMLInputElement).value.trim(),
      state: (document.getElementById("evt-state") as HTMLInputElement).value.trim(),
      description: (document.getElementById("evt-desc") as HTMLTextAreaElement).value.trim(),
      ticketUrl: (document.getElementById("evt-ticket") as HTMLInputElement).value.trim(),
      flyerUrl: (document.getElementById("evt-flyer") as HTMLInputElement).value.trim(),
      isPublic: true,
    };

    const res = await fetch("/api/events", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });

    if (res.ok) {
      showStatus("Event added");
      // Clear form
      ["evt-title", "evt-date", "evt-time", "evt-venue", "evt-city", "evt-state", "evt-desc", "evt-ticket", "evt-flyer"].forEach((id) => {
        (document.getElementById(id) as HTMLInputElement).value = "";
      });
      loadEvents();
    } else {
      showStatus("Failed to add event");
    }
  });

  (window as any).toggleEventPublic = async (id: string, isPublic: boolean) => {
    await fetch("/api/events", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, isPublic }),
    });
    loadEvents();
  };

  (window as any).deleteEvent = async (id: string) => {
    await fetch(`/api/events?id=${id}`, { method: "DELETE" });
    showStatus("Event deleted");
    loadEvents();
  };

  // --- Gallery ---
  const galleryListEl = document.getElementById("gallery-list")!;
  const galUrlInput = document.getElementById("gal-url") as HTMLInputElement;
  const galPreview = document.getElementById("gal-preview")!;
  const galPreviewImg = document.getElementById("gal-preview-img") as HTMLImageElement;

  galUrlInput.addEventListener("input", () => {
    if (galUrlInput.value) {
      galPreviewImg.src = galUrlInput.value;
      galPreview.classList.remove("hidden");
      galPreviewImg.onerror = () => galPreview.classList.add("hidden");
    } else {
      galPreview.classList.add("hidden");
    }
  });

  async function loadGallery() {
    const res = await fetch("/api/gallery?all=1");
    const { images } = await res.json();
    renderGallery(images);
  }

  function renderGallery(images: any[]) {
    if (images.length === 0) {
      galleryListEl.innerHTML = `<p class="col-span-full text-neutral-500 text-sm">No images yet.</p>`;
      return;
    }
    galleryListEl.innerHTML = images
      .map((img: any) => `
        <div class="relative group ${!img.isPublic ? 'opacity-50' : ''}">
          <div class="aspect-square bg-neutral-900 rounded-md overflow-hidden">
            <img src="${img.url}" alt="${img.alt || img.caption || ''}" class="w-full h-full object-cover" />
          </div>
          ${img.caption ? `<p class="mt-1 text-xs text-neutral-500 truncate">${img.caption}</p>` : ''}
          <div class="absolute top-1 right-1 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <button onclick="toggleGalleryPublic('${img.id}', ${!img.isPublic})" class="px-1.5 py-0.5 text-xs rounded bg-black/70 ${img.isPublic ? 'text-green-400' : 'text-neutral-400'}">
              ${img.isPublic ? 'Public' : 'Hidden'}
            </button>
            <button onclick="deleteGalleryImage('${img.id}')" class="px-1.5 py-0.5 text-xs rounded bg-black/70 text-red-400">
              &times;
            </button>
          </div>
        </div>
      `)
      .join("");
  }

  document.getElementById("gal-add-btn")!.addEventListener("click", async () => {
    const url = galUrlInput.value.trim();
    if (!url) return showStatus("Image URL is required");

    const caption = (document.getElementById("gal-caption") as HTMLInputElement).value.trim();
    const res = await fetch("/api/gallery", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ url, caption, isPublic: true }),
    });

    if (res.ok) {
      showStatus("Image added");
      galUrlInput.value = "";
      (document.getElementById("gal-caption") as HTMLInputElement).value = "";
      galPreview.classList.add("hidden");
      loadGallery();
    } else {
      showStatus("Failed to add image");
    }
  });

  (window as any).toggleGalleryPublic = async (id: string, isPublic: boolean) => {
    await fetch("/api/gallery", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, isPublic }),
    });
    loadGallery();
  };

  (window as any).deleteGalleryImage = async (id: string) => {
    await fetch(`/api/gallery?id=${id}`, { method: "DELETE" });
    showStatus("Image removed");
    loadGallery();
  };

  // --- Init ---
  checkAuth();
</script>
