---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Motif Movement — Lubbock Sound System">
  <section class="-mx-4 relative overflow-hidden" style="min-height: 70vh;">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/customer-assets/double%20sprout%20and%20system%20png.png');"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/60 via-neutral-950/40 to-neutral-950"></div>
    <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 py-24 sm:py-32" style="min-height: 70vh;">
      <h2 class="font-[Space_Grotesk,system-ui,sans-serif] text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
        Sound. Movement. <br class="sm:hidden" />Lubbock.
      </h2>
      <p class="mt-6 sm:mt-8 text-neutral-300 max-w-xl mx-auto leading-relaxed text-base sm:text-lg">
        A bass collective by the people, of the people, for the people — bringing bone-shaking sound and high-fidelity rigs to West Texas.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/contact"
          class="inline-block px-6 py-3 rounded-full bg-neutral-100 text-neutral-950 font-semibold hover:bg-white transition-colors"
        >
          Book the system
        </a>
        <a
          href="/events"
          class="inline-block px-6 py-3 rounded-full border border-neutral-700 text-neutral-100 hover:border-neutral-400 transition-colors"
        >
          Upcoming events
        </a>
      </div>
    </div>
  </section>
</Layout>
