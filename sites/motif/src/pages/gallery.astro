<Layout title="Gallery — Motif Movement">
  <section class="pt-10 sm:pt-14">
    <h2 class="font-[Space_Grotesk,system-ui,sans-serif] text-3xl sm:text-4xl font-bold">Gallery</h2>
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-2">
      {galleryImages.map((img) => (
        <a
          href={`/customer-assets/Gallery/${img}`}
          target="_blank"
          rel="noopener"
          class="block group"
        >
          <div class="aspect-square bg-neutral-900 rounded-md overflow-hidden">
            <img
              src={`/customer-assets/Gallery/${img}`}
              alt=""
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
